# Backend (FastAPI) settings. Copy to .env or set them on the host.

# Exact origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://alpha-nexus-ashy.vercel.app
# Optional project-specific regex for extra origins. Disabled by default.
# Prefer adding exact preview URLs above; do not allow all *.vercel.app sites.
# ALLOWED_ORIGIN_REGEX=
# Where the SQLite run history is stored. Defaults to alphanexus.db in the
# working directory; point it at a persistent disk to keep history across deploys.
# DATABASE_PATH=alphanexus.db

# POST /backtests is limited to 20 requests per client per minute per API
# process, including save=false runs. Excess requests return 429 and Retry-After.
# History retains the newest 1,000 runs, trimmed on each successful save.

# Backend (FastAPI) settings. Copy to .env or set them on the host.

# Exact origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Pattern for extra origins, such as Vercel preview deployments.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
# Where the SQLite run history is stored. Defaults to alphanexus.db in the
# working directory; point it at a persistent disk to keep history across deploys.
# DATABASE_PATH=alphanexus.db
